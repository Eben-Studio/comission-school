{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/content/**",
              "components/school/**",
              "ui_kits/instagram-posts/**",
              "ui_kits/school-platform/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Bebas Neue|Garet|Playfair Display))/i]",
        "message": "Font not provided by the design system. Available: Bebas Neue, Garet, Playfair Display."
      },
      {
        "selector": "JSXOpeningElement[name.name='GrainBackground'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|style|key|ref|className|style|children)$/]",
        "message": "<GrainBackground> doesn't accept that prop. Declared props: tone, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='GrainBackground'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:blue|red|cream|dark)$/]",
        "message": "<GrainBackground> tone must be one of 'blue' | 'red' | 'cream' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HighlightMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|underline|children|style|key|ref|className|style|children)$/]",
        "message": "<HighlightMark> doesn't accept that prop. Declared props: tone, underline, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='HighlightMark'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:paper|red|blue|dark)$/]",
        "message": "<HighlightMark> tone must be one of 'paper' | 'red' | 'blue' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='InitialsAvatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|style|key|ref|className|style|children)$/]",
        "message": "<InitialsAvatar> doesn't accept that prop. Declared props: name, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='OccupancyMeter'] > JSXAttribute > JSXIdentifier[name!=/^(?:occupied|max|style|key|ref|className|style|children)$/]",
        "message": "<OccupancyMeter> doesn't accept that prop. Declared props: occupied, max, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pill'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|style|key|ref|className|style|children)$/]",
        "message": "<Pill> doesn't accept that prop. Declared props: tone, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Pill'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:blue|red|paper|neutral|outline)$/]",
        "message": "<Pill> tone must be one of 'blue' | 'red' | 'paper' | 'neutral' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PostFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:width|children|key|ref|className|style|children)$/]",
        "message": "<PostFrame> doesn't accept that prop. Declared props: width, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuoteMark'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|children|style|key|ref|className|style|children)$/]",
        "message": "<QuoteMark> doesn't accept that prop. Declared props: tone, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuoteMark'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<QuoteMark> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StickerElement'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|rotate|style|key|ref|className|style|children)$/]",
        "message": "<StickerElement> doesn't accept that prop. Declared props: name, size, rotate, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StickerElement'] > JSXAttribute[name.name='name'] > Literal[value!=/^(?:bird-blue|bird-red|flower-blue|flower-red|mountain-blue|mountain-red|blob-blue|blob-red|star-blue|star-red)$/]",
        "message": "<StickerElement> name must be one of 'bird-blue' | 'bird-red' | 'flower-blue' | 'flower-red' | 'mountain-blue' | 'mountain-red' | 'blob-blue' | 'blob-red' | 'star-blue' | 'star-red'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "GrainBackground": {
        "replaces": []
      },
      "HighlightMark": {
        "replaces": []
      },
      "InitialsAvatar": {
        "replaces": []
