      "--highlight-pad-y",
      "--paper-100",
      "--radius-none",
      "--radius-pill",
      "--radius-sm",
      "--red-600",
      "--shadow-inset-hairline",
      "--space-1",
      "--space-2",
      "--space-3",
      "--space-4",
      "--space-5",
      "--space-6",
      "--space-7",
      "--space-8",
      "--space-9",
      "--surface-accent-blue",
      "--surface-accent-red",
      "--surface-highlight-paper",
      "--surface-inverse",
      "--surface-page",
      "--text-accent-quote",
      "--text-body-lg",
      "--text-body-md",
      "--text-body-sm",
      "--text-body-xl",
      "--text-display-lg",
      "--text-display-md",
      "--text-display-sm",
